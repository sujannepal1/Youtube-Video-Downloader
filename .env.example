# Copy this file to .env and replace ALL placeholder values before running.
# Never commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_DB=ytaudio

# ── Application ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:REPLACE_WITH_A_STRONG_PASSWORD@db:5432/ytaudio
REDIS_URL=redis://redis:6379/0
DOWNLOAD_DIR=/data/audio
